# Add these to the secrets.yaml your ESPHome dashboard already uses
# (on 192.168.1.134). wifi_ssid/wifi_password almost certainly already
# exist there since your other devices use them - reuse those, don't
# duplicate.
#
# master_bedroom_curtains_api_key must match whatever key the device is
# currently running (the dashboard's onboarding wizard generates one when
# you adopt the base-ESPHome flash) - don't just invent a new random one
# here, or the running device and this config will disagree and the API
# connection will fail. Pull the real value from the device's current
# config (dashboard -> device -> Edit, or the /json-config API) the first
# time you wire this file up.

wifi_ssid: "NovemberOscarTangoHotel"
wifi_password: "<your existing wifi password secret>"

master_bedroom_curtains_api_key: "<the api.encryption.key the adopted device is already running>"
